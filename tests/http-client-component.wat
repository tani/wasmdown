;; The M16 slice-5 e2e fixture: a guest that imports wasi:http/types +
;; wasi:http/client, builds a GET request (a header, the authority, a
;; path), sends it, and reads the status + the first response-body
;; byte. The test substitutes the loopback port for @@PORT@@ and its
;; decimal length for @@ALEN@@.
(component
 (import "wasi:http/types@0.3.2"
  (instance $t
   (export "fields" (type $F0 (sub resource)))
   (export "[constructor]fields" (func (result (own $F0))))
   (export "[method]fields.append"
     (func (param "self" (borrow $F0)) (param "name" string)
                 (param "value" (list u8)) (result (result (error u32)))))
   (export "request" (type $R0 (sub resource)))
   (export "[static]request.new"
     (func (param "headers" (own $F0)) (param "contents" (option (stream u8)))
                 (param "trailers" (future u32)) (param "options" (option u32))
                 (result (tuple (own $R0) (future u32)))))
   (export "[method]request.set-authority"
     (func (param "self" (borrow $R0)) (param "authority" (option string))
                 (result (result))))
   (export "[method]request.set-path-with-query"
     (func (param "self" (borrow $R0)) (param "path-with-query" (option string))
                 (result (result))))
   (export "response" (type $RSP0 (sub resource)))
   (export "[method]response.get-status-code"
     (func (param "self" (borrow $RSP0)) (result u32)))
   (export "[static]response.consume-body"
     (func (param "this" (own $RSP0)) (param "res" (future u32))
                 (result (tuple (stream u8) (future (result (error u32)))))))))
 (alias export $t "fields" (type $F))
 (alias export $t "request" (type $R))
 (alias export $t "response" (type $RSP))
 (alias export $t "[constructor]fields" (func $ctor))
 (alias export $t "[method]fields.append" (func $append))
 (alias export $t "[static]request.new" (func $new))
 (alias export $t "[method]request.set-authority" (func $auth))
 (alias export $t "[method]request.set-path-with-query" (func $path))
 (alias export $t "[method]response.get-status-code" (func $status))
 (alias export $t "[static]response.consume-body" (func $body))
 (import "wasi:http/client@0.3.2"
  (instance $c
   (export "send" (func async (param "request" (own $R))
                          (result (result (own $RSP) u32))))))
 (alias export $c "send" (func $send))
 (type $FT (future u32))
 (core module $Mem (memory (export "mem") 1)
   (data (i32.const 512) "x-test")
   (data (i32.const 600) "h")
   (data (i32.const 640) "127.0.0.1:@@PORT@@")
   (data (i32.const 660) "/hi"))
 (core instance $memory (instantiate $Mem))
 (core func $ctor-l (canon lower (func $ctor) (memory (core memory $memory "mem"))))
 (core func $append-l (canon lower (func $append) (memory (core memory $memory "mem"))))
 (core func $new-l (canon lower (func $new) (memory (core memory $memory "mem"))))
 (core func $auth-l (canon lower (func $auth) (memory (core memory $memory "mem"))))
 (core func $path-l (canon lower (func $path) (memory (core memory $memory "mem"))))
 (core func $status-l (canon lower (func $status) (memory (core memory $memory "mem"))))
 (core func $body-l (canon lower (func $body) (memory (core memory $memory "mem"))))
 (core func $send-l (canon lower (func $send) async (memory (core memory $memory "mem"))))
 (type $ST (stream u8))
 (canon stream.read $ST async (memory (core memory $memory "mem")) (core func $sread))
 (canon future.new $FT (core func $fnew))
 (canon subtask.drop (core func $subdrop))
 (canon waitable.join (core func $join))
 (canon waitable-set.new (core func $wsnew))
 (canon waitable-set.wait (memory (core memory $memory "mem")) (core func $wait))
 (core module $M
  (import "env" "mem" (memory 1))
  (import "env" "ctor" (func $ctor (result i32)))
  (import "env" "append" (func $append (param i32 i32 i32 i32 i32 i32)))
  (import "env" "new" (func $new (param i32 i32 i32 i32 i32 i32 i32)))
  (import "env" "auth" (func $auth (param i32 i32 i32 i32) (result i32)))
  (import "env" "path" (func $path (param i32 i32 i32 i32) (result i32)))
  (import "env" "send" (func $send (param i32 i32) (result i32)))
  (import "env" "status" (func $status (param i32) (result i32)))
  (import "env" "body" (func $body (param i32 i32 i32)))
  (import "env" "sread" (func $sread (param i32 i32 i32) (result i32)))
  (import "env" "fnew" (func $fnew (result i64)))
  (import "env" "subdrop" (func $subdrop (param i32)))
  (import "env" "join" (func $join (param i32 i32)))
  (import "env" "wsnew" (func $wsnew (result i32)))
  (import "env" "wait" (func $wait (param i32 i32) (result i32)))
  (func $poll-subtask (param $packed i32) (param $ws i32)
    (local $sub i32)
    (if (i32.ne (i32.and (local.get $packed) (i32.const 15)) (i32.const 2))
      (then
        (local.set $sub (i32.shr_u (local.get $packed) (i32.const 4)))
        (call $join (local.get $sub) (local.get $ws))
        (block $done
          (loop $poll
            (drop (call $wait (local.get $ws) (i32.const 224)))
            (br_if $done (i32.eq (i32.load (i32.const 224)) (i32.const 1)))
            (br_if $done (i32.ge_u (i32.load (i32.const 228)) (i32.const 2)))
            (br $poll)))
        (if (i32.ne (i32.const 1) (i32.load (i32.const 224))) (then unreachable))
        (call $subdrop (local.get $sub)))))
  (func (export "f") (result i32)
    (local $f i32) (local $req i32) (local $rsp i32) (local $ws i32)
    (local $packed i32) (local $pair i64) (local $ftr i32)
    (local $bp i64) (local $bs i32) (local $bf i32) (local $r i32)
    (local $st i32)
    (local.set $f (call $ctor))
    (call $append (local.get $f) (i32.const 512) (i32.const 6)
                  (i32.const 600) (i32.const 1) (i32.const 700))
    (if (i32.ne (i32.const 0) (i32.load8_u (i32.const 700))) (then unreachable))
    (local.set $pair (call $fnew))
    (local.set $ftr (i32.wrap_i64 (local.get $pair)))
    (call $new (local.get $f) (i32.const 0) (i32.const 0) (local.get $ftr)
               (i32.const 0) (i32.const 0) (i32.const 720))
    (local.set $req (i32.load (i32.const 720)))
    (local.set $r (call $auth (local.get $req) (i32.const 1)
                             (i32.const 640) (i32.const @@ALEN@@)))
    (if (i32.ne (i32.const 0) (local.get $r)) (then unreachable))
    (local.set $r (call $path (local.get $req) (i32.const 1)
                             (i32.const 660) (i32.const 3)))
    (if (i32.ne (i32.const 0) (local.get $r)) (then unreachable))
    (local.set $ws (call $wsnew))
    (local.set $packed (call $send (local.get $req) (i32.const 736)))
    (call $poll-subtask (local.get $packed) (local.get $ws))
    (if (i32.ne (i32.const 2) (i32.and (local.get $packed) (i32.const 15)))
      (then unreachable))
    (if (i32.ne (i32.const 0) (i32.load8_u (i32.const 736))) (then unreachable))
    (local.set $rsp (i32.load (i32.const 744)))
    (local.set $st (call $status (local.get $rsp)))
    (local.set $bp (call $fnew))
    (local.set $bs (i32.wrap_i64 (local.get $bp)))
    (call $body (local.get $rsp) (local.get $bs) (i32.const 760))
    (local.set $bs (i32.load (i32.const 760)))
    (local.set $bf (i32.load (i32.const 764)))
    (local.set $r (call $sread (local.get $bs) (i32.const 800) (i32.const 16)))
    (i32.add (i32.shl (local.get $st) (i32.const 8))
             (i32.load8_u (i32.const 800)))))
 (core instance $m (instantiate $M (with "env" (instance
   (export "mem" (memory $memory "mem"))
   (export "ctor" (func $ctor-l))
   (export "append" (func $append-l))
   (export "new" (func $new-l))
   (export "auth" (func $auth-l))
   (export "path" (func $path-l))
   (export "send" (func $send-l))
   (export "status" (func $status-l))
   (export "body" (func $body-l))
   (export "sread" (func $sread))
   (export "fnew" (func $fnew))
   (export "subdrop" (func $subdrop))
   (export "join" (func $join))
   (export "wsnew" (func $wsnew))
   (export "wait" (func $wait))))))
 (func (export "f") (result u32) (canon lift (core func $m "f"))))
