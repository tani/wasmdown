    (local.set $f (call $ctor))
    (call $append (local.get $f) (i32.const 512) (i32.const 6)
                  (i32.const 600) (i32.const 1) (i32.const 700))
    (if (i32.ne (i32.const 0) (i32.load8_u (i32.const 700))) (then unreachable))
    (local.set $pair (call $fnew-tr))
    (local.set $ftr (i32.wrap_i64 (local.get $pair)))
    (call $new (local.get $f) (i32.const 0) (i32.const 0) (local.get $ftr)
               (i32.const 0) (i32.const 0) (i32.const 720))
    (local.set $req (i32.load (i32.const 720)))
    (local.set $r (call $auth (local.get $req) (i32.const 1)
                             (i32.const 640) (i32.const @@ALEN@@)))
    (if (i32.ne (i32.const 0) (local.get $r)) (then unreachable))
    (local.set $r (call $path (local.get $req) (i32.const 1)
                             (i32.const 660) (i32.const 3)))
    (if (i32.ne (i32.const 0) (local.get $r)) (then unreachable))
    (local.set $ws (call $wsnew))
    (local.set $packed (call $send (local.get $req) (i32.const 736)))
    (call $poll-subtask (local.get $packed) (local.get $ws))
    (if (i32.ne (i32.const 2) (i32.and (local.get $packed) (i32.const 15)))
      (then unreachable))
    (if (i32.ne (i32.const 0) (i32.load8_u (i32.const 736))) (then unreachable))
    (local.set $rsp (i32.load (i32.const 744)))
    (local.set $st (call $status (local.get $rsp)))
    (local.set $bp (call $fnew))
    (local.set $bs (i32.wrap_i64 (local.get $bp)))
    (call $body (local.get $rsp) (local.get $bs) (i32.const 760))
    (local.set $bs (i32.load (i32.const 760)))
    (local.set $bf (i32.load (i32.const 764)))
    (local.set $r (call $sread (local.get $bs) (i32.const 800) (i32.const 16)))
    (i32.add (i32.shl (local.get $st) (i32.const 8))
             (i32.load8_u (i32.const 800)))))
 (core instance $m (instantiate $M (with "env" (instance
   (export "mem" (memory $memory "mem"))
   (export "ctor" (func $ctor-l))
   (export "append" (func $append-l))
   (export "new" (func $new-l))
   (export "auth" (func $auth-l))
   (export "path" (func $path-l))
   (export "send" (func $send-l))
   (export "status" (func $status-l))
   (export "body" (func $body-l))
