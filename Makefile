# WASMDOWN developer commands (subset of PLAN.md §12.7 targets).

SBCL ?= sbcl
ROOT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
LISP_FILES := $(wildcard src/*.lisp)

.PHONY: all test test-unit test-spec-core report-conformance clean load-system repl

all: test

load-system:
	$(SBCL) --non-interactive \
	  --eval '(require :asdf)' \
	  --eval "(pushnew #P\"$(ROOT)/\" asdf:*central-registry*)" \
	  --eval '(asdf:load-system :wasmdown)' \
	  --eval '(quit)'

test: test-unit

test-unit:
	$(SBCL) --script tools/run-tests.lisp

# Core spec-script conformance lane (PLAN.md §12.7): run the vendored
# official suite subset through the stateful WAST runner. Unsupported
# feature files are classified, never silently passed.
test-spec-core:
	$(SBCL) --script tools/run-spec-core.lisp

report-conformance: test-spec-core
	@echo "CONFORMANCE.md regenerated by test-spec-core"

repl:
	$(SBCL) --eval '(require :asdf)' \
	  --eval "(pushnew #P\"$(ROOT)/\" asdf:*central-registry*)" \
	  --eval '(asdf:load-system :wasmdown)'
