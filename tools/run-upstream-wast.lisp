;;;; Upstream-testsuite WAST lane (PLAN.md §12.7/§12.8).
;;;;
;;;; Runs an ARBITRARY directory of .wast scripts through the stateful
;;;; WAST runner and emits one JSONL result per command plus a short
;;;; summary. This is the ADAPTER the upstream WebAssembly/testsuite
;;;; mirror is measured through: the vendored core suite keeps its own
;;;; pinned lane (tools/run-spec-core.lisp); this one takes a pattern
;;;; from the environment so the fetch tool can point it at a fresh
;;;; checkout, a proposal branch, or a bisection directory.
;;;;
;;;; Environment:
;;;;   WASMDOWN_WAST_PATTERN   glob, default "tests/spec-core/*.wast"
;;;;   WASMDOWN_WAST_JSONL     output path, default
;;;;                           "tests/upstream-results.jsonl"
;;;;   WASMDOWN_WAST_LABEL     suite label for messages
;;;;
;;;; The exit code is ALWAYS 0: a measurement lane never converts an
;;;; unsupported/timeout/harness-error into a pass, and never fails a
;;;; build on someone else's proposal corpus (PLAN.md §12.9).

(require :asdf)

(defparameter *root*
  (make-pathname :directory (butlast (pathname-directory *load-truename*))))

(pushnew *root* asdf:*central-registry* :test #'equal)

(asdf:load-system :wasmdown)

(defun %env (name default)
  (let ((v (uiop:getenv name)))
    (if (and v (plusp (length v))) v default)))

(defparameter *pattern* (%env "WASMDOWN_WAST_PATTERN" "tests/spec-core/*.wast"))
(defparameter *jsonl* (%env "WASMDOWN_WAST_JSONL" "tests/upstream-results.jsonl"))
(defparameter *label* (%env "WASMDOWN_WAST_LABEL" "upstream"))

(defparameter *results*
  (wasmdown.wast:run-directory *root*
                               :pattern *pattern*
                               :jsonl-path (merge-pathnames *jsonl* *root*)
                               :suite (if (search "upstream" *label*)
                                          "upstream"
                                          *label*)))

(let ((counts (make-hash-table :test #'eq))
      (files (make-hash-table :test #'equal)))
  (dolist (r *results*)
    (incf (gethash (wasmdown.wast:wast-result-outcome r) counts 0))
    (setf (gethash (namestring (wasmdown.wast:wast-result-file r)) files)
          t))
  (format t "~&~a: ~d commands over ~d files~%"
          *label* (length *results*) (hash-table-count files))
  (dolist (o '(:pass :fail :skip :unsupported :timeout :harness-error
               :expected-fail))
    (format t "  ~16a ~d~%" (string-downcase (string o))
            (or (gethash o counts) 0)))
  (format t "  jsonl            ~a~%" (merge-pathnames *jsonl* *root*))
  ;; the lane's public artifact (PLAN.md §12.8): totals + the failing
  ;; files, committed beside the JSONL so a reader never has to parse
  ;; 60k lines to see where the corpus stands
  (let* ((by-file (make-hash-table :test #'equal))
         (by-detail (make-hash-table :test #'equal))
         (out (merge-pathnames "CONFORMANCE-UPSTREAM.md" *root*)))
    (dolist (r *results*)
      (when (eq (wasmdown.wast:wast-result-outcome r) :fail)
        (incf (gethash (wasmdown.wast:wast-result-file r) by-file 0))
        (let ((d (wasmdown.wast:wast-result-detail r)))
          (incf (gethash (subseq d 0 (min 60 (length d))) by-detail 0)))))
    (with-open-file (s out :direction :output :if-exists :supersede)
      (format s "# CONFORMANCE-UPSTREAM.md — aggregated testsuite mirror~%~%")
      (format s "Generated by `make test-upstream` (tools/run-upstream-testsuite.py).~%")
      (format s "**Discovery lane, not a release gate** (PLAN.md §12.9): the mirror carries~%")
      (format s "proposal corpora beyond the declared engine scope, and its files are never~%")
      (format s "counted together with the pinned core suite. Unsupported/timeout/~%")
      (format s "harness-error outcomes are reported as themselves, never converted.~%~%")
      (format s "- Suite label: `~a`~%- Source: the pin fetched by the adapter (~a)~%~%"
              *label* *jsonl*)
      (format s "## Aggregate outcome counts~%~%")
      (format s "| Outcome | Count |~%| --- | --- |~%")
      (dolist (o '(:pass :fail :skip :unsupported :timeout :harness-error
                   :expected-fail))
        (format s "| ~a | ~d |~%" (string-downcase (string o))
                (or (gethash o counts) 0)))
      (format s "| **total** | **~d** |~%~%" (length *results*))
      (format s "## Files with failures (count desc)~%~%")
      (format s "| File | Failures |~%| --- | --- |~%")
      (let ((rows '()))
        (maphash (lambda (f n) (push (cons f n) rows)) by-file)
        (dolist (row (sort rows #'> :key #'cdr))
          (format s "| ~a | ~d |~%" (car row) (cdr row))))
      (format s "~%## Failure detail classes~%~%")
      (format s "| Detail | Count |~%| --- | --- |~%")
      (let ((rows '()))
        (maphash (lambda (d n) (push (cons d n) rows)) by-detail)
        (dolist (row (sort rows #'> :key #'cdr))
          (format s "| ~a | ~d |~%"
                  (substitute #\Space #\| (substitute #\Space #\Newline
                                                        (car row)))
                  (cdr row)))))
    (format t "  summary          ~a~%" out)))
