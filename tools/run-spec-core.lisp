;;;; Core spec-script conformance lane (PLAN.md §12.7/§12.8).
;;;; Runs the vendored official suite (tests/spec-core/*.wast, pinned
;;;; in specs/lock.toml) through the stateful WAST runner and emits:
;;;;   - tests/spec-core-results.jsonl  (one result per command)
;;;;   - CONFORMANCE.md                 (per-file + aggregate report)
;;;; Exit code is ALWAYS 0: this is a baseline MEASUREMENT, not a
;;;; release gate; failures are quantified honestly instead of
;;;; aborting. Gates are defined in PLAN.md §12.9.

(require :asdf)

(defparameter *root*
  (make-pathname :directory (butlast (pathname-directory *load-truename*))))

(pushnew *root* asdf:*central-registry* :test #'equal)

(asdf:load-system :wasmdown)

(defparameter *files*
  (sort (directory (merge-pathnames "tests/spec-core/*.wast" *root*))
        #'string< :key #'namestring))

(defparameter *jsonl*
  (merge-pathnames "tests/spec-core-results.jsonl" *root*))

(defparameter *results*
  (wasmdown.wast:run-directory *root*
                               :pattern "tests/spec-core/*.wast"
                               :jsonl-path *jsonl*))

;;; ---- CONFORMANCE.md (PLAN.md §12.8) ----

(defun outcome-counts (results)
  (let ((table (make-hash-table :test #'eq)))
    (dolist (r results)
      (incf (gethash (wasmdown.wast:wast-result-outcome r) table 0)))
    table))

(defun %fmt (table outcome)
  (or (gethash outcome table) 0))

(let ((table (outcome-counts *results*))
      (out (merge-pathnames "CONFORMANCE.md" *root*)))
  (with-open-file (s out :direction :output :if-exists :supersede)
    (format s "# CONFORMANCE.md — core spec-script baseline~%~%")
    (format s "Generated by `make report-conformance` (tools/run-spec-core.lisp).~%")
    (format s "This is a **baseline measurement, not a release gate** per PLAN.md §12.8;~%")
    (format s "`unsupported` counts are out-of-scope features~%")
    (format s "(SIMD/GC/EH/tail-calls and the unadopted-annotations proposal); this runner~%")
    (format s "reports and does not fail the build, so read the counts, not the exit code.~%")
    (format s "Historical note, kept for provenance: an earlier classification pass moved~%")
    (format s "277 -> 725 such commands out of `harness-error` and into honest~%")
    (format s ":unsupported`; the pinned baseline now records its own numbers above.~%~%")
    (format s "- Pinned suite: WebAssembly/spec `b0ec1f3f449525c217dbff3f1dfab435a756ea92` (2026-10-22)~%")
    (format s "- Engine scope declared: MVP + bulk-memory + sign-ext + non-trapping-float + multi-value + reference-types (`partial`, PLAN.md §2)~%~%")
    (format s "## Aggregate outcome counts~%~%")
    (format s "| Outcome | Count |~%| --- | --- |~%")
    (dolist (o '(:pass :fail :skip :unsupported :timeout :harness-error))
      (format s "| ~a | ~d |~%" (string-downcase (string o)) (%fmt table o)))
    (let* ((total (reduce #'+ (loop for v being the hash-values of table collect v)))
           (pass (%fmt table :pass)))
      (format s "| **total** | **~d** |~%~%" total)
      (format s "Executed: ~d commands; pass rate ~,1f% (denominator = all executed,~%including unsupported — honest per PLAN.md §12.9).~%~%"
              total (if (zerop total) 0.0 (* 100.0 (/ pass total)))))
    (format s "## Per-file counts~%~%")
    (format s "| File | pass | fail | unsupported | other |~%| --- | --- | --- | --- | --- |~%")
    (dolist (f *files*)
      (let* ((fname (pathname-name f))
             (rs (remove-if-not
                  (lambda (r)
                    (string= (pathname-name (wasmdown.wast:wast-result-file r))
                             fname))
                  *results*))
             (ft (outcome-counts rs)))
        (format s "| ~a | ~d | ~d | ~d | ~d |~%" fname
                (%fmt ft :pass) (%fmt ft :fail) (%fmt ft :unsupported)
                (+ (%fmt ft :skip) (%fmt ft :timeout)
                   (%fmt ft :harness-error)))))))

(format t "~&CONFORMANCE.md + tests/spec-core-results.jsonl written.~%")
